{
  "id": null,
  "uid": "highpay-overview",
  "title": "HighPay Overview",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "15s",
  "panels": [
    {
      "type": "stat",
      "title": "Payments Created",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(highpay_payment_created_total[5m]))",
          "legendFormat": "created"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Payments Approved",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(highpay_payment_approved_total[5m]))",
          "legendFormat": "approved"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Processor Failures",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 4 },
      "targets": [
        {
          "expr": "sum(increase(highpay_processor_processing_failed_total[5m]))",
          "legendFormat": "failures"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Service Availability",
      "gridPos": { "x": 0, "y": 4, "w": 18, "h": 8 },
      "targets": [
        {
          "expr": "up{job=~\"payment-service|payment-processor|provider-simulator\"}",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
